{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "on monday"
  ],
  "rebaseWhen": "conflicted",
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "groupName": "all dependencies",
    "groupSlug": "all-dependencies"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track digest-pinned container images in workflows. The github-actions manager reads container:/image: only as literal strings, so anything behind ${{ matrix.container }} is invisible to it.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:container|image):\\s+[\"']?(?<depName>[^\\s@\"']+?)(?::(?<currentValue>[^\\s@\"'/]+))?@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "cargo",
        "mise",
        "rust-toolchain"
      ],
      "minimumReleaseAge": "20 days",
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": [
        "dockerfile",
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies"
    }
  ]
}
