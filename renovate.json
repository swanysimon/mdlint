{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Los_Angeles",
  "schedule": [
    "on monday"
  ],
  "rebaseWhen": "conflicted",
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "groupName": "all dependencies",
    "groupSlug": "all-dependencies"
  },
  "packageRules": [
    {
      "matchManagers": [
        "cargo",
        "mise",
        "rust-toolchain"
      ],
      "minimumReleaseAge": "20 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "groupName": "all dependencies",
      "groupSlug": "all-dependencies",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "replacement"
      ],
      "rangeStrategy": "bump"
    }
  ]
}
